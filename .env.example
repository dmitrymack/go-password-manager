# Copy to .env and adjust. Real environment variables override this file.

POSTGRES_USER=gophkeeper
POSTGRES_PASSWORD=gophkeeper
POSTGRES_DB=gophkeeper
POSTGRES_PORT=5433

# Server, when run outside Docker (`./bin/gophkeeper-server`).
# Inside Docker, docker-compose.yml overrides the DSN host and TLS paths.
DATABASE_DSN=postgres://gophkeeper:gophkeeper@localhost:5433/gophkeeper?sslmode=disable
# At least 32 characters. Generate: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
TLS_CERT=certs/server.crt
TLS_KEY=certs/server.key
